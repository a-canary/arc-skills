#!/bin/bash
# budget-gate [--ceiling F]: hard stop for headless batches. 0 under, 1 at/over, 2 meter unreadable (fails closed).
M=${BUDGET_METER:-$HOME/vault/director/.budget/meter.json}
C=${BUDGET_GATE_CEILING:-0.70}
[ "$1" = --ceiling ] && C=$2
jq -en --arg c "$C" '$c|tonumber' >/dev/null 2>&1 || { echo "budget-gate: non-numeric ceiling: $C" >&2; exit 2; }
U=$(jq -er '."5h".util | select(type=="number" and (isnan|not))' "$M" 2>/dev/null) || { echo "budget-gate: no readable 5h util in $M" >&2; exit 2; }
R=$(jq -n --argjson u "$U" --argjson c "$C" 'if ($u|isnan) or ($c|isnan) or ($u|isinfinite) or ($c|isinfinite) then error else $u >= $c end' 2>/dev/null) || { echo "budget-gate: cannot compare util $U to ceiling $C" >&2; exit 2; }
[ "$R" = true ] && { echo "budget-gate: 5h util $U >= $C" >&2; exit 1; }
[ "$R" = false ] || exit 2
