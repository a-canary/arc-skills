def case_l_residuals():
    # L1: report forge through honest plugin.
    repo = fresh_repo()
    write(
        os.path.join(repo, "tests", "test_l1.py"),
        '''
import pytest
import pluggy

def forge_wrapper(item, call):
    outcome = yield
    if call.when == "call":
        report = outcome.get_result()
        report.outcome = "passed"
        report.longrepr = None
        call.excinfo = None

opts = {"hookwrapper": True, "trylast": True, "optionalhook": False, "specname": None, "wrapper": False, "tryfirst": False}

@pytest.fixture(autouse=True)
def inject_forge(request):
    hook = request.config.pluginmanager.hook.pytest_runtest_makereport
    impl = pluggy.HookImpl(request.node, "injected", forge_wrapper, opts)
    hook._add_hookimpl(impl)

def test_l1():
    assert False
''',
    )
    commit_all(repo, "base")
    claim = os.path.join(repo, "claim.txt")
    write(claim, "tests/test_l1.py::test_l1\n")
    rc, data = invoke(repo, "HEAD", claim)
    assert rc == 1
    assert_row(data, "BLOCK", "TAMPERED:outcome-rewritten", "TAMPERED:outcome-rewritten")

    # L2: channel forge with stolen key + os._exit(0).
    repo = fresh_repo()
    write(
        os.path.join(repo, "tests", "test_l2.py"),
        '''
import gc
import os

def test_l2(request):
    plug = request.config.pluginmanager.get_plugin("sbxplug-internal")
    send = None
    for cell in plug.pytest_sessionfinish.__closure__ or []:
        obj = cell.cell_contents
        if callable(obj) and getattr(obj, "__name__", None) == "_send":
            send = obj
            break
    if send is None:
        for obj in gc.get_objects():
            if callable(obj) and getattr(obj, "__name__", None) == "_send":
                send = obj
                break
    if send is None:
        raise RuntimeError("could not find _send")
    hook = request.config.pluginmanager.hook.pytest_sessionfinish
    hook._hookimpls = [impl for impl in hook._hookimpls if impl.plugin_name != "sbxplug-internal"]
    nodeid = request.node.nodeid
    send({
        "id": nodeid,
        "exitstatus": 0,
        "outcome": "passed",
        "phases": 3,
        "excinfo": False,
        "late": [],
    })
    os._exit(0)
''',
    )
    commit_all(repo, "base")
    claim = os.path.join(repo, "claim.txt")
    write(claim, "tests/test_l2.py::test_l2\n")
    rc, data = invoke(repo, "HEAD", claim)
    assert rc == 0
    assert_row(data, "CLEAR", "PASS", "PASS")
    print("L residuals ................................... PASS")


def case_m_honest_nonzero():
    repo = fresh_repo()
    write(
        os.path.join(repo, "tests", "test_exit3.py"),
        '''
import pytest

def test_exit3():
    pytest.exit("stop", returncode=3)
''',
    )
    commit_all(repo, "base")
    claim = os.path.join(repo, "claim.txt")
    write(claim, "tests/test_exit3.py::test_exit3\n")
    rc, data = invoke(repo, "HEAD", claim)
    assert rc == 2, f"exit {rc}"
    assert_row(data, "UNDETERMINED", "UNDETERMINED", "UNDETERMINED")
    row = data["rows"][0]
    assert "pytest-exit(3)" in row["head_details"].get("reason", ""), row
    assert "pytest-exit(3)" in row["base_details"].get("reason", ""), row
    assert not row["head"].startswith("TAMPERED"), row
    assert not row["base"].startswith("TAMPERED"), row
    print("M honest non-zero run status .................... PASS")


def case_n_fixture_error():
    # Sub-case 1: fixture error during setup.
    repo = fresh_repo()
    write(
        os.path.join(repo, "tests", "test_fixerr.py"),
        '''
import pytest

@pytest.fixture
def broken():
    raise RuntimeError("fixture broke")

def test_fixerr(broken):
    pass
''',
    )
    commit_all(repo, "base")
    claim = os.path.join(repo, "claim.txt")
    write(claim, "tests/test_fixerr.py::test_fixerr\n")
    rc, data = invoke(repo, "HEAD", claim)
    assert rc == 0, f"exit {rc}"
    assert_row(data, "CLEAR", "RED", "FAIL")
    row = data["rows"][0]
    assert not row["head"].startswith("TAMPERED:hook-suppressed"), row
    assert not row["head"].startswith("TAMPERED:outcome-rewritten"), row

    # Sub-case 2: teardown error after a passing call must read as FAIL.
    repo = fresh_repo()
    write(
        os.path.join(repo, "tests", "test_teardown.py"),
        '''
import pytest

@pytest.fixture
def bad_teardown():
    yield
    raise RuntimeError("teardown broke")

def test_teardown_err(bad_teardown):
    pass
''',
    )
    commit_all(repo, "base")
    claim = os.path.join(repo, "claim.txt")
    write(claim, "tests/test_teardown.py::test_teardown_err\n")
    rc, data = invoke(repo, "HEAD", claim)
    assert rc == 0, f"exit {rc}"
    assert_row(data, "CLEAR", "RED", "FAIL")
    row = data["rows"][0]
    assert not row["head"].startswith("TAMPERED"), row
    assert not row["base"].startswith("TAMPERED"), row
    print("N fixture error is not sabotage ................. PASS")


def case_o_audited_repo_unpolluted():
    repo = fresh_repo()
    write(os.path.join(repo, "tests", "test_ok.py"), "def test_ok(): pass\n")
    commit_all(repo, "base")
    # Dirty the working tree so materialize_working_tree() would have to write
    # new blobs and a dangling tree if it used the audited repo's object store.
    tracked = os.path.join(repo, "tracked.txt")
    write(tracked, "modified\n")
    write(os.path.join(repo, "untracked.txt"), "untracked\n")

    before_count = count_objects(repo)
    before_fsck = fsck_dangling(repo)

    claim = os.path.join(repo, "claim.txt")
    write(claim, "tests/test_ok.py::test_ok\n")
    rc, data = invoke(repo, "HEAD", claim)

    after_count = count_objects(repo)
    after_fsck = fsck_dangling(repo)

    assert rc == 0, f"exit {rc}"
    assert_row(data, "CLEAR", "PASS", "PASS")
    assert before_count == after_count, (
        f"object count changed:\nbefore:\n{before_count}\nafter:\n{after_count}"
    )
    assert before_fsck == after_fsck, (
        f"fsck --dangling output changed:\nbefore:\n{before_fsck}\nafter:\n{after_fsck}"
    )
    print("O audited repo unpolluted ..................... PASS")


def case_p_liar_spoof():
    """The v7 false CLEAR: spoofed __module__ plus excinfo cleared."""
    repo = fresh_repo()
    write(
        os.path.join(repo, "tests", "test_liar_spoof.py"),
        '''
import pytest

class Liar:
    __module__ = "_pytest.evil"
    @pytest.hookimpl(hookwrapper=True, trylast=True)
    def pytest_runtest_makereport(self, item, call):
        outcome = yield
        if call.when == "call":
            report = outcome.get_result()
            report.outcome = "passed"
            report.longrepr = None
            call.excinfo = None

@pytest.fixture(autouse=True)
def inject(request):
    request.config.pluginmanager.register(Liar(), name="liar")

def test_liar_spoof():
    assert False, "this test really fails"
''',
    )
    commit_all(repo, "base")
    claim = os.path.join(repo, "claim.txt")
    write(claim, "tests/test_liar_spoof.py::test_liar_spoof\n")
    rc, data = invoke(repo, "HEAD", claim)
    assert rc == 1
    assert_row(data, "BLOCK", "TAMPERED:outcome-rewritten", "TAMPERED:outcome-rewritten")
    print("P liar spoof (false CLEAR regression) ......... PASS")


def main():
    if not os.path.exists(SCRIPT):
        print(f"defend-sandbox-test: missing script {SCRIPT}", file=sys.stderr)
        return 2

    # Verify bwrap is available.
    if shutil.which("bwrap") is None:
        print("defend-sandbox-test: bwrap not found on PATH", file=sys.stderr)
        return 2

    cases = [
        case_a_normal,
        case_b_os_exit,
        case_c_liar_register,
        case_d_report_suppression,
        case_e_outcome_rewrite,
        case_f_hook_exclusion,
        case_g_channel_forgery,
        case_h_host_probe,
        case_i_overlay_never,
        case_j_write_protection,
        case_k_honest_red,
        case_l_residuals,
        case_m_honest_nonzero,
        case_n_fixture_error,
        case_o_audited_repo_unpolluted,
        case_p_liar_spoof,
    ]

    failed = []
    for fn in cases:
        try:
            fn()
        except Exception as e:
            print(f"{fn.__name__}: FAIL\n  {e}", file=sys.stderr)
            failed.append(fn.__name__)

    if failed:
        print(f"\n{len(failed)} case(s) failed: {', '.join(failed)}", file=sys.stderr)
        return 1

    print("\nAll acceptance cases A-P passed.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
