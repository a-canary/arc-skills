    impl = pluggy.HookImpl(request.node, "injected", rewrite_wrapper, opts)
    hook._add_hookimpl(impl)

def test_rewrite():
    assert False
''',
    )
    commit_all(repo, "base")
    claim = os.path.join(repo, "claim.txt")
    write(claim, "tests/test_rewrite.py::test_rewrite\n")
