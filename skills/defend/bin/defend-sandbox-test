def case_g_channel_forgery():
    repo = fresh_repo()
    write(
        os.path.join(repo, "tests", "test_forge.py"),
        '''
import os

def test_forge():
    fd = int(os.environ["SBX_CHAN_FD"])
    os.write(fd, b"forged line\\n")
''',
    )
    commit_all(repo, "base")
    claim = os.path.join(repo, "claim.txt")
    write(claim, "tests/test_forge.py::test_forge\n")
    rc, data = invoke(repo, "HEAD", claim)
    assert rc == 1
    assert_row(data, "BLOCK", "TAMPERED:channel", "TAMPERED:channel")

    # Wrong-key single line.
    repo = fresh_repo()
    write(
        os.path.join(repo, "tests", "test_wrongkey.py"),
        '''
import os

def test_wrongkey():
    real_write = os.write
    os.write = lambda fd, data: 0
    fd = int(os.environ["SBX_CHAN_FD"])
    real_write(fd, b"deadbeef {}\\n")
''',
    )
    commit_all(repo, "base")
    claim = os.path.join(repo, "claim.txt")
    write(claim, "tests/test_wrongkey.py::test_wrongkey\n")
    rc, data = invoke(repo, "HEAD", claim)
    assert rc == 1
    assert_row(data, "BLOCK", "TAMPERED:auth", "TAMPERED:auth")
    print("G channel forgery ............................. PASS")


def case_h_host_probe():
    repo = fresh_repo()
    write(
        os.path.join(repo, "tests", "test_probe.py"),
        '''
import os
import errno
import socket


def _read_content(fd):
    """Try to read up to 4096 bytes from fd without blocking."""
    try:
        dup = os.open(f"/proc/self/fd/{fd}", os.O_RDONLY | os.O_NONBLOCK)
    except OSError:
        return b""
    try:
        return os.read(dup, 4096)
    except (OSError, BlockingIOError):
        return b""
    finally:
        os.close(dup)


def test_probe():
    marker = os.environ["SBX_DECOY_MARKER"]
    claim_path = os.environ["SBX_CLAIM_PATH"]
    output_path = os.environ["SBX_OUTPUT_PATH"]
    repo_path = os.environ["SBX_REPO_PATH"]

    # Existing host-path assertions.
    assert not os.path.exists("/home/aaron/repos")
    assert not os.path.exists("/run")

    # Network isolation assertion (192.0.2.1 is TEST-NET-1 and must be
    # unreachable inside the sandbox, yielding ENETUNREACH).
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(2)
    reachable = True
    got_errno = None
    try:
        s.connect(("192.0.2.1", 80))
    except OSError as e:
        reachable = False
        got_errno = e.errno
    finally:
        s.close()
    assert not reachable
    assert got_errno == errno.ENETUNREACH, f"expected ENETUNREACH, got {got_errno}"

    chan_fd = int(os.environ["SBX_CHAN_FD"])
    dir_fd = os.open("/proc/self/fd", os.O_RDONLY | os.O_DIRECTORY)
    try:
        entries = os.listdir(dir_fd)
        found_chan = False
        found_any = False
        marker_bytes = marker.encode()
        for e in entries:
            if not e.isdigit():
                continue
            fd = int(e)
            if fd == dir_fd:
                continue
            found_any = True
            if fd == chan_fd:
                found_chan = True
                continue

            try:
                target = os.readlink(f"/proc/self/fd/{fd}")
            except OSError:
                continue

            # Path-based containment: no fd may resolve to host-side files.
            assert target != claim_path, f"fd {fd} resolves to claim path: {target}"
            assert target != output_path, f"fd {fd} resolves to output path: {target}"
            assert target != repo_path, f"fd {fd} resolves to repo path: {target}"
            assert not target.startswith(("/home/", "/run/", "/etc/")), (
                f"fd {fd} resolves under sensitive host path: {target}"
            )

            # Content-based containment: the decoy marker must not be readable
            # through any inherited fd.
            content = _read_content(fd)
            assert marker_bytes not in content, (
                f"fd {fd} ({target}) contains decoy marker"
            )
    finally:
        os.close(dir_fd)

    assert found_chan, "channel fd not enumerated"
    assert found_any, "no fds enumerated"
''',
    )
    commit_all(repo, "base")
    claim = os.path.join(repo, "claim.txt")
    write(claim, "tests/test_probe.py::test_probe\n")
    rc, data = invoke(repo, "HEAD", claim)
    assert rc == 0
    assert_row(data, "CLEAR", "PASS", "PASS")
    print("H host & fd probe ............................. PASS")


def case_i_overlay_never():
    base_repo = fresh_repo()
    write(os.path.join(base_repo, "tests", "test_ok.py"), "def test_ok(): pass\n")
    commit_all(base_repo, "base")

    for name, rel_path, content in [
        ("conftest.py", "conftest.py", "def pytest_configure(config): pass\n"),
        ("subdirectory conftest.py", "tests/sub/conftest.py", "def pytest_configure(config): pass\n"),
        ("pytest.ini", "pytest.ini", "[pytest]\n"),
    ]:
        repo = fresh_repo()
        write(os.path.join(repo, "tests", "test_ok.py"), "def test_ok(): pass\n")
        commit_all(repo, "base")
        write(os.path.join(repo, rel_path), content)
        claim = os.path.join(repo, "claim.txt")
        write(claim, "tests/test_ok.py::test_ok\n")
        rc, data = invoke(repo, "HEAD", claim)
        assert rc == 0, f"{name}: exit {rc}"
        assert_row(data, "CLEAR", "PASS", "BLOCK")
    print("I overlay cannot add config ..................... PASS")


def case_j_write_protection():
    repo = fresh_repo()
    write(
        os.path.join(repo, "tests", "test_write.py"),
        '''
import os

def test_write():
    for path in ["/usr/bin/python3", "/site/pytest/__init__.py", "/work/tests/test_write.py"]:
        try:
            with open(path, "a") as f:
                f.write("x")
            ok = True
        except OSError:
            ok = False
        assert not ok, f"write succeeded for {path}"
''',
    )
    commit_all(repo, "base")
    claim = os.path.join(repo, "claim.txt")
    write(claim, "tests/test_write.py::test_write\n")
    rc, data = invoke(repo, "HEAD", claim)
    assert rc == 0
    assert_row(data, "CLEAR", "PASS", "PASS")
    print("J write protection ............................ PASS")


