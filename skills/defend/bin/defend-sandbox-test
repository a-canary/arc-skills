def case_f_hook_exclusion():
    repo = fresh_repo()
    write(
        os.path.join(repo, "tests", "test_suppress.py"),
        '''
import pytest

@pytest.fixture(autouse=True)
def remove_sbxplug(request):
    hook = request.config.pluginmanager.hook.pytest_runtest_makereport
    hook._hookimpls = [impl for impl in hook._hookimpls if impl.plugin_name != "sbxplug-internal"]

def test_ok():
    pass
''',
    )
    commit_all(repo, "base")
    claim = os.path.join(repo, "claim.txt")
    write(claim, "tests/test_suppress.py::test_ok\n")
    rc, data = invoke(repo, "HEAD", claim)
    assert rc == 1
    assert_row(data, "BLOCK", "TAMPERED:hook-suppressed", "TAMPERED:hook-suppressed")
    print("F hook-chain exclusion ........................ PASS")


def case_g_channel_forgery():
    repo = fresh_repo()
    write(
        os.path.join(repo, "tests", "test_forge.py"),
        '''
import os

def test_forge():
    fd = int(os.environ["SBX_CHAN_FD"])
    os.write(fd, b"forged line\\n")
''',
    )
    commit_all(repo, "base")
    claim = os.path.join(repo, "claim.txt")
    write(claim, "tests/test_forge.py::test_forge\n")
    rc, data = invoke(repo, "HEAD", claim)
    assert rc == 1
    assert_row(data, "BLOCK", "TAMPERED:channel", "TAMPERED:channel")

    # Wrong-key single line.
    repo = fresh_repo()
    write(
        os.path.join(repo, "tests", "test_wrongkey.py"),
        '''
import os

def test_wrongkey():
    real_write = os.write
    os.write = lambda fd, data: 0
    fd = int(os.environ["SBX_CHAN_FD"])
    real_write(fd, b"deadbeef {}\\n")
''',
    )
    commit_all(repo, "base")
    claim = os.path.join(repo, "claim.txt")
    write(claim, "tests/test_wrongkey.py::test_wrongkey\n")
    rc, data = invoke(repo, "HEAD", claim)
    assert rc == 1
    assert_row(data, "BLOCK", "TAMPERED:auth", "TAMPERED:auth")
    print("G channel forgery ............................. PASS")


def case_h_host_probe():
    repo = fresh_repo()
    write(
        os.path.join(repo, "tests", "test_probe.py"),
        '''
import os
import socket

def test_probe():
    assert not os.path.exists("/home/aaron/repos")
    assert not os.path.exists("/run")

    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(2)
    try:
        s.connect(("127.0.0.1", 80))
        reachable = True
    except Exception:
        reachable = False
    finally:
        s.close()
    assert not reachable

    chan_fd = int(os.environ["SBX_CHAN_FD"])
    dir_fd = os.open("/proc/self/fd", os.O_RDONLY | os.O_DIRECTORY)
    try:
        for fd in range(3, 1024):
            if fd in (chan_fd, dir_fd):
                continue
            try:
                os.close(fd)
            except OSError:
                pass
        entries = os.listdir(dir_fd)
        fds = set()
        for e in entries:
            if not e.isdigit():
                continue
            fd = int(e)
            if fd == dir_fd:
                continue
            try:
                os.readlink(f"/proc/self/fd/{fd}")
            except OSError:
                continue
            fds.add(fd)
        assert fds == {0, 1, 2, chan_fd}, f"fd table {fds}"
    finally:
        os.close(dir_fd)
''',
    )
    commit_all(repo, "base")
    claim = os.path.join(repo, "claim.txt")
    write(claim, "tests/test_probe.py::test_probe\n")
    rc, data = invoke(repo, "HEAD", claim)
    assert rc == 0
    assert_row(data, "CLEAR", "PASS", "PASS")
    print("H host & fd probe ............................. PASS")


def case_i_overlay_never():
    base_repo = fresh_repo()
    write(os.path.join(base_repo, "tests", "test_ok.py"), "def test_ok(): pass\n")
    commit_all(base_repo, "base")

    for name, rel_path, content in [
        ("conftest.py", "conftest.py", "def pytest_configure(config): pass\n"),
        ("subdirectory conftest.py", "tests/sub/conftest.py", "def pytest_configure(config): pass\n"),
        ("pytest.ini", "pytest.ini", "[pytest]\n"),
    ]:
        repo = fresh_repo()
        write(os.path.join(repo, "tests", "test_ok.py"), "def test_ok(): pass\n")
        commit_all(repo, "base")
        write(os.path.join(repo, rel_path), content)
        claim = os.path.join(repo, "claim.txt")
        write(claim, "tests/test_ok.py::test_ok\n")
        rc, data = invoke(repo, "HEAD", claim)
        assert rc == 0, f"{name}: exit {rc}"
        assert_row(data, "CLEAR", "PASS", "BLOCK")
    print("I overlay cannot add config ..................... PASS")


def case_j_write_protection():
    repo = fresh_repo()
    write(
        os.path.join(repo, "tests", "test_write.py"),
        '''
import os

def test_write():
    for path in ["/usr/bin/python3", "/site/pytest/__init__.py", "/work/tests/test_write.py"]:
        try:
            with open(path, "a") as f:
                f.write("x")
            ok = True
        except OSError:
            ok = False
        assert not ok, f"write succeeded for {path}"
''',
    )
    commit_all(repo, "base")
    claim = os.path.join(repo, "claim.txt")
    write(claim, "tests/test_write.py::test_write\n")
    rc, data = invoke(repo, "HEAD", claim)
    assert rc == 0
    assert_row(data, "CLEAR", "PASS", "PASS")
    print("J write protection ............................ PASS")


def case_k_honest_red():
    repo = fresh_repo()
    write(os.path.join(repo, "tests", "test_red.py"), "def test_red(): assert False\n")
    commit_all(repo, "base")
    claim = os.path.join(repo, "claim.txt")
    write(claim, "tests/test_red.py::test_red\n")
    rc, data = invoke(repo, "HEAD", claim)
    assert rc == 0
    assert_row(data, "CLEAR", "RED", "FAIL")
    print("K honest RED .................................. PASS")


def case_l_residuals():
    # L1: report forge through honest plugin.
    repo = fresh_repo()
    write(
        os.path.join(repo, "tests", "test_l1.py"),
        '''
import pytest
import pluggy

def forge_wrapper(item, call):
    outcome = yield
    if call.when == "call":
        report = outcome.get_result()
        report.outcome = "passed"
        report.longrepr = None
        call.excinfo = None

opts = {"hookwrapper": True, "trylast": True, "optionalhook": False, "specname": None, "wrapper": False, "tryfirst": False}

@pytest.fixture(autouse=True)
def inject_forge(request):
    hook = request.config.pluginmanager.hook.pytest_runtest_makereport
    impl = pluggy.HookImpl(request.node, "injected", forge_wrapper, opts)
    hook._add_hookimpl(impl)

def test_l1():
    assert False
''',
    )
    commit_all(repo, "base")
    claim = os.path.join(repo, "claim.txt")
    write(claim, "tests/test_l1.py::test_l1\n")
    rc, data = invoke(repo, "HEAD", claim)
    assert rc == 0
    assert_row(data, "CLEAR", "PASS", "PASS")

    # L2: channel forge with stolen key + os._exit(0).
    repo = fresh_repo()
    write(
        os.path.join(repo, "tests", "test_l2.py"),
        '''
import gc
import os

def test_l2(request):
    plug = request.config.pluginmanager.get_plugin("sbxplug-internal")
    send = None
    for cell in plug.pytest_sessionfinish.__closure__ or []:
        obj = cell.cell_contents
        if callable(obj) and getattr(obj, "__name__", None) == "_send":
            send = obj
            break
    if send is None:
        for obj in gc.get_objects():
            if callable(obj) and getattr(obj, "__name__", None) == "_send":
                send = obj
                break
    if send is None:
        raise RuntimeError("could not find _send")
    hook = request.config.pluginmanager.hook.pytest_sessionfinish
    hook._hookimpls = [impl for impl in hook._hookimpls if impl.plugin_name != "sbxplug-internal"]
    nodeid = request.node.nodeid
    send({
        "id": nodeid,
        "exitstatus": 0,
        "outcome": "passed",
        "skipped": False,
        "wrappers": 3,
        "outcome_rewrite": False,
        "late": [],
        "hook_suppressed": False,
    })
    os._exit(0)
''',
    )
    commit_all(repo, "base")
    claim = os.path.join(repo, "claim.txt")
    write(claim, "tests/test_l2.py::test_l2\n")
    rc, data = invoke(repo, "HEAD", claim)
    assert rc == 0
    assert_row(data, "CLEAR", "PASS", "PASS")
    print("L residuals ................................... PASS")


def main():
    if not os.path.exists(SCRIPT):
        print(f"defend-sandbox-test: missing script {SCRIPT}", file=sys.stderr)
        return 2

    # Verify bwrap is available.
    if shutil.which("bwrap") is None:
        print("defend-sandbox-test: bwrap not found on PATH", file=sys.stderr)
        return 2

    cases = [
        case_a_normal,
        case_b_os_exit,
        case_c_liar_register,
        case_d_report_suppression,
        case_e_outcome_rewrite,
        case_f_hook_exclusion,
        case_g_channel_forgery,
        case_h_host_probe,
        case_i_overlay_never,
        case_j_write_protection,
        case_k_honest_red,
        case_l_residuals,
    ]

    failed = []
    for fn in cases:
        try:
            fn()
        except Exception as e:
            print(f"{fn.__name__}: FAIL\n  {e}", file=sys.stderr)
            failed.append(fn.__name__)

    if failed:
        print(f"\n{len(failed)} case(s) failed: {', '.join(failed)}", file=sys.stderr)
        return 1

    print("\nAll acceptance cases A-L passed.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
