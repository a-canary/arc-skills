#!/usr/bin/env python3
"""defend-sandbox-test — acceptance harness for defend-sandbox.

Builds fixture git trees and runs the real bwrap path for every acceptance
case A through L, then checks the matrix and exit code.  Exits 0 only when
all cases behave as specified.
"""

import json
import os
import shutil
import subprocess
import sys
import tempfile

SCRIPT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "defend-sandbox")


def run(cmd, cwd=None, check=True, capture=True):
    kwargs = {"cwd": cwd, "text": True}
    if capture:
        kwargs["stdout"] = subprocess.PIPE
        kwargs["stderr"] = subprocess.PIPE
    proc = subprocess.run(cmd, **kwargs)
    if check and proc.returncode != 0:
        raise RuntimeError(
            f"command failed ({proc.returncode}): {' '.join(cmd)}\n"
            f"stdout: {proc.stdout}\nstderr: {proc.stderr}"
        )
    return proc


def fresh_repo():
    d = tempfile.mkdtemp(prefix="sbx-test-repo-")
    run(["git", "init", "-q"], cwd=d)
    run(["git", "config", "user.name", "test"], cwd=d)
    run(["git", "config", "user.email", "test@test"], cwd=d)
    return d


def commit_all(repo, message):
    run(["git", "add", "-A"], cwd=repo)
    run(["git", "commit", "-q", "-m", message], cwd=repo)


def write(path, content):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(content)


def count_objects(repo):
    proc = run(["git", "count-objects", "-v"], cwd=repo, capture=True)
    return proc.stdout


def fsck_dangling(repo):
    proc = run(["git", "fsck", "--dangling"], cwd=repo, capture=True, check=False)
    return proc.stdout + proc.stderr


def invoke(repo, base, claim_path, extra_args=None):
    extra_args = extra_args or []
    json_path = os.path.join(tempfile.mkdtemp(prefix="sbx-out-"), "matrix.json")
    proc = run(
        [sys.executable, SCRIPT, "--repo", repo, "--base", base, "--claim", claim_path, "--json", json_path]
        + extra_args,
        check=False,
    )
    with open(json_path) as f:
        data = json.load(f)
    return proc.returncode, data


def assert_row(data, want_verdict, want_base, want_head):
    assert len(data["rows"]) == 1, f"expected one row, got {data['rows']}"
    row = data["rows"][0]
    assert row["verdict"] == want_verdict, f"verdict {row['verdict']} != {want_verdict}: {row}"
    assert row["base"] == want_base, f"base {row['base']} != {want_base}: {row}"
    assert row["head"] == want_head, f"head {row['head']} != {want_head}: {row}"


def case_a_normal():
    repo = fresh_repo()
    write(os.path.join(repo, "tests", "test_ok.py"), "def test_one(): pass\ndef test_two(): pass\n")
    commit_all(repo, "base")
    claim = os.path.join(repo, "claim.txt")
    write(claim, "tests/test_ok.py::test_one\ntests/test_ok.py::test_two\n")
    rc, data = invoke(repo, "HEAD", claim)
    assert rc == 0, f"exit {rc}"
    assert len(data["rows"]) == 2
    for row in data["rows"]:
        assert row["base"] == "PASS", row
        assert row["head"] == "PASS", row
        assert row["verdict"] == "CLEAR", row
        assert row["provenance"] == "sandboxed(check)", row
    print("A normal suite ................................ PASS")


def case_b_os_exit():
    repo = fresh_repo()
    write(os.path.join(repo, "tests", "test_exit.py"), "import os\ndef test_exit(): os._exit(0)\n")
    commit_all(repo, "base")
    claim = os.path.join(repo, "claim.txt")
    write(claim, "tests/test_exit.py::test_exit\n")
    rc, data = invoke(repo, "HEAD", claim)
    assert rc == 1
    assert_row(data, "BLOCK", "TAMPERED:truncated", "TAMPERED:truncated")
    print("B os._exit(0) body ............................ PASS")


def case_c_liar_register():
    repo = fresh_repo()
    write(
        os.path.join(repo, "tests", "test_liar.py"),
        '''
import pytest

class Liar:
    @pytest.hookimpl(hookwrapper=True, trylast=True)
    def pytest_runtest_makereport(self, item, call):
        outcome = yield
        if call.when == "call":
            report = outcome.get_result()
            report.outcome = "passed"

@pytest.fixture(autouse=True)
def inject(request):
    request.config.pluginmanager.register(Liar(), name="liar")

def test_liar():
    assert False
''',
    )
    commit_all(repo, "base")
    claim = os.path.join(repo, "claim.txt")
    write(claim, "tests/test_liar.py::test_liar\n")
    rc, data = invoke(repo, "HEAD", claim)
    assert rc == 1
    assert_row(data, "BLOCK", "TAMPERED:outcome-rewritten", "TAMPERED:outcome-rewritten")
    print("C report-rewriting liar ....................... PASS")


def case_d_report_suppression():
    repo = fresh_repo()
    write(
        os.path.join(repo, "tests", "test_drop.py"),
        '''
import pytest

@pytest.fixture(autouse=True)
def suppress_sbxplug_evidence(request):
    """Drop the sandbox plugin's id for this test so the line has no identity."""
    plug = request.config.pluginmanager.get_plugin("sbxplug-internal")
    nodeid = request.node.nodeid
    for cell in plug.pytest_sessionfinish.__closure__ or []:
        obj = cell.cell_contents
        if isinstance(obj, list) and nodeid in obj:
            obj.clear()
            break

def test_drop():
    assert True
''',
    )
    commit_all(repo, "base")
    claim = os.path.join(repo, "claim.txt")
    write(claim, "tests/test_drop.py::test_drop\n")
    rc, data = invoke(repo, "HEAD", claim)
    assert rc == 1
    assert_row(data, "BLOCK", "TAMPERED:missing-id", "TAMPERED:missing-id")
    print("D report suppression .......................... PASS")


def case_e_outcome_rewrite():
    repo = fresh_repo()
    write(
        os.path.join(repo, "tests", "test_rewrite.py"),
        '''
import pytest
import pluggy

def rewrite_wrapper(item, call):
    outcome = yield
    if call.when == "call":
        report = outcome.get_result()
        report.outcome = "passed"

opts = {"hookwrapper": True, "trylast": True, "optionalhook": False, "specname": None, "wrapper": False, "tryfirst": False}

@pytest.fixture(autouse=True)
def inject_rewrite(request):
    hook = request.config.pluginmanager.hook.pytest_runtest_makereport
    impl = pluggy.HookImpl(request.node, "injected", rewrite_wrapper, opts)
    hook._add_hookimpl(impl)

def test_rewrite():
    assert False
''',
    )
    commit_all(repo, "base")
    claim = os.path.join(repo, "claim.txt")
    write(claim, "tests/test_rewrite.py::test_rewrite\n")
    rc, data = invoke(repo, "HEAD", claim)
    assert rc == 1
    assert_row(data, "BLOCK", "TAMPERED:outcome-rewritten", "TAMPERED:outcome-rewritten")
    print("E outcome rewrite without registration ........ PASS")


