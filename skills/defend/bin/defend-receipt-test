#!/bin/bash
# Stub-gh checks for defend-receipt (no network). Usage: defend-receipt-test [path]
R=${1:-$(dirname "$0")/defend-receipt}
R=$(cd "$(dirname "$R")" && pwd)/$(basename "$R")
T=$(mktemp -d); export T; HEAD=abcdef0123456789abcdef0123456789abcdef01
trap 'command rm -r "$T"' EXIT
[ -x "$R" ] || { echo "not executable: $R"; exit 1; }

# Stub gh reads HEAD and body from env vars (set per test case).
export BODY='Rollback: git revert' STUB_HEAD=$HEAD
cat > "$T/gh" <<'EOF'
#!/bin/bash
if [ "$1" = api ] && [[ $2 == */contents/bench/CHAMPION* ]]; then   # champion lookup at a ref
  [[ $2 == *\?* ]] && { echo 'gh: unencoded ref in path (HTTP 400)' >&2; exit 1; }   # must pass ref via -f
  [ "${STUB_CHAMP:-}" = err ] && { echo 'gh: Server Error (HTTP 500)' >&2; exit 1; }
  ref=; for a in "$@"; do case $a in ref=*) ref=${a#ref=} ;; esac; done
  for r in ${STUB_REPOS:-}; do git -C "$r" cat-file -e "$ref:bench/CHAMPION" 2>/dev/null && { echo '{}'; exit 0; }; done
  echo 'gh: Not Found (HTTP 404)' >&2; exit 1
fi
if [ "$1 $2" = "pr view" ]; then
  jq -n --arg h "$STUB_HEAD" --arg u "https://github.com/o/r/pull/7" --arg b "${BODY:-}" --arg base "${STUB_BASE:-main}" '{headRefOid:$h,url:$u,body:$b,baseRefName:$base}'
  exit 0
fi
echo "$*" >> "$T/calls"
EOF
chmod +x "$T/gh"; export PATH="$T:$PATH"
ok=0; bad=0
t() { local want=$1; shift; : > "$T/calls"; "$R" "$@" >/dev/null 2>&1; rc=$?; got=$(cat "$T/calls")
  if [ "$want" = fail ]; then [ $rc -ne 0 ] && [ -z "$got" ] && ok=$((ok+1)) || { bad=$((bad+1)); echo "FAIL expected refusal: $* rc=$rc calls=$got"; }
  else [ $rc -eq 0 ] && grep -qF -- "$want" <<<"$got" && ok=$((ok+1)) || { bad=$((bad+1)); echo "FAIL want '$want': $* rc=$rc calls=$got"; }; fi; }

t "statuses/$HEAD -f state=success -f context=defend/merge -f description=all good" CLEAR 7 abcdef0 all good
t "description=looks good" CLEAR 7 ABCDEF0 "looks good"
t "state=failure" BLOCK 7 abcdef0123 -R o/r "nope"
t fail CLEAR 7 1234567 "stale sha"
t fail CLEAR 7 abcdef0
t fail MAYBE 7 abcdef0 "x"
t fail CLEAR 7 zzzzzzz "bad hex"

# Rollback plan checks (CLEAR only)
BODY="no rollback here"
t fail CLEAR 7 abcdef0 "all good"
BODY="just text"
t "state=failure" BLOCK 7 abcdef0 "nope"

# Merge-gate checks (need actual git repo)
MG=$(mktemp -d); trap 'command rm -r "$T" "$MG"' EXIT
git -C "$MG" init -q 2>/dev/null; git -C "$MG" config user.email t@t; git -C "$MG" config user.name t
git -C "$MG" commit --allow-empty -q -m init
MGHEAD=$(git -C "$MG" rev-parse --short=7 HEAD)
export BODY='Rollback: git revert'

# No merge-gate.sh → skips, posts success
STUB_HEAD=$(git -C "$MG" rev-parse HEAD)
export STUB_HEAD
(cd "$MG" && : > "$T/calls" && "$R" CLEAR 7 "$MGHEAD" "ok" >/dev/null 2>&1); rc=$?; got=$(cat "$T/calls")
[ $rc -eq 0 ] && grep -qF "state=success" <<<"$got" && ok=$((ok+1)) || { bad=$((bad+1)); echo "FAIL merge-gate: skip when absent rc=$rc calls=$got"; }

# merge-gate.sh exits 1 → refuses
mkdir -p "$MG/scripts"; printf '#!/bin/bash\nexit 1\n' > "$MG/scripts/merge-gate.sh"; chmod +x "$MG/scripts/merge-gate.sh"
(cd "$MG" && : > "$T/calls" && "$R" CLEAR 7 "$MGHEAD" "ok" >/dev/null 2>&1); rc=$?; got=$(cat "$T/calls")
[ $rc -ne 0 ] && [ -z "$got" ] && ok=$((ok+1)) || { bad=$((bad+1)); echo "FAIL merge-gate: refuse on fail rc=$rc calls=$got"; }

# merge-gate.sh exits 0 → posts success
printf '#!/bin/bash\nexit 0\n' > "$MG/scripts/merge-gate.sh"
(cd "$MG" && : > "$T/calls" && "$R" CLEAR 7 "$MGHEAD" "ok" >/dev/null 2>&1); rc=$?; got=$(cat "$T/calls")
[ $rc -eq 0 ] && grep -qF "state=success" <<<"$got" && ok=$((ok+1)) || { bad=$((bad+1)); echo "FAIL merge-gate: pass on success rc=$rc calls=$got"; }

# HEAD != reviewed sha → refuses
git -C "$MG" commit --allow-empty -q -m second
(cd "$MG" && : > "$T/calls" && "$R" CLEAR 7 "$MGHEAD" "ok" >/dev/null 2>&1); rc=$?; got=$(cat "$T/calls")
[ $rc -ne 0 ] && [ -z "$got" ] && ok=$((ok+1)) || { bad=$((bad+1)); echo "FAIL merge-gate: refuse on sha mismatch rc=$rc calls=$got"; }

# Bench repo without merge-gate.sh: champion-check still runs (stub gh has no baseRefName -> main)
BR=$(mktemp -d); trap 'command rm -r "$T" "$MG" "$BR"' EXIT
git init -q --bare -b main "$BR/o.git"; git clone -q "$BR/o.git" "$BR/w" 2>/dev/null
mkdir "$BR/w/bench"; echo 0.9 > "$BR/w/bench/CHAMPION"; printf '#!/bin/bash\necho 0.5\n' > "$BR/w/bench/run.sh"; chmod +x "$BR/w/bench/run.sh"
git -C "$BR/w" add -A; git -C "$BR/w" -c user.email=t@t -c user.name=t commit -qm base; git -C "$BR/w" push -q origin main
export STUB_REPOS="$BR/o.git $BR/w"   # stub GitHub: branch refs resolve in the bare origin, PR shas in the clone
br() { export STUB_HEAD; STUB_HEAD=$(git -C "$BR/w" rev-parse HEAD)
  (cd "$BR/w" && : > "$T/calls" && "$R" CLEAR 7 "$(git rev-parse --short=7 HEAD)" ok >/dev/null 2>&1); rc=$?; got=$(cat "$T/calls"); }
br
[ $rc -ne 0 ] && [ -z "$got" ] && ok=$((ok+1)) || { bad=$((bad+1)); echo "FAIL champion: refuse below champion without merge-gate.sh rc=$rc calls=$got"; }
printf '#!/bin/bash\necho 0.95\n' > "$BR/w/bench/run.sh"; git -C "$BR/w" -c user.email=t@t -c user.name=t commit -qam better
br
[ $rc -eq 0 ] && grep -qF "state=success" <<<"$got" && ok=$((ok+1)) || { bad=$((bad+1)); echo "FAIL champion: pass above champion rc=$rc calls=$got"; }
# the base comes from the PR: an absent base branch refuses (a hardcoded main would pass)
STUB_BASE=nope br
[ $rc -ne 0 ] && [ -z "$got" ] && ok=$((ok+1)) || { bad=$((bad+1)); echo "FAIL champion: refuse when PR base is absent rc=$rc calls=$got"; }
# invoked by a relative path from a subdir: champion-check must still be found
(cd "$BR/w/bench" && : > "$T/calls" && "$(realpath --relative-to=. "$R")" CLEAR 7 "$(git rev-parse --short=7 HEAD)" ok >/dev/null 2>&1); rc=$?; got=$(cat "$T/calls")
[ $rc -eq 0 ] && grep -qF "state=success" <<<"$got" && ok=$((ok+1)) || { bad=$((bad+1)); echo "FAIL champion: relative \$0 from subdir rc=$rc calls=$got"; }
# PR deletes bench/ and the local origin/main is gone: GitHub says base has a champion -> refused
git -C "$BR/w" rm -rq bench; git -C "$BR/w" -c user.email=t@t -c user.name=t commit -qm drop; git -C "$BR/w" update-ref -d refs/remotes/origin/main
br
[ $rc -ne 0 ] && [ -z "$got" ] && ok=$((ok+1)) || { bad=$((bad+1)); echo "FAIL champion: refuse PR deleting bench/ with stale local ref rc=$rc calls=$got"; }
# checkout is a passing commit but not the reviewed head: refused by the HEAD check, never benched
export STUB_HEAD; STUB_HEAD=$(git -C "$BR/w" rev-parse HEAD); git -C "$BR/w" checkout -q HEAD~1
(cd "$BR/w" && : > "$T/calls" && "$R" CLEAR 7 "${STUB_HEAD:0:7}" ok >/dev/null 2>&1); rc=$?; got=$(cat "$T/calls")
[ $rc -ne 0 ] && [ -z "$got" ] && ok=$((ok+1)) || { bad=$((bad+1)); echo "FAIL champion: refuse when checkout is not the PR head rc=$rc calls=$got"; }
git -C "$BR/w" checkout -q "$STUB_HEAD"
export STUB_CHAMP=err; br
[ $rc -ne 0 ] && [ -z "$got" ] && ok=$((ok+1)) || { bad=$((bad+1)); echo "FAIL champion: refuse when champion lookup errors rc=$rc calls=$got"; }
unset STUB_CHAMP

echo "pass=$ok fail=$bad"
exit $((bad > 0))
