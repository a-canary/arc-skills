#!/bin/bash
# defend-attack plumbing with stubbed models (no network). Screener behaviour: see defend-screen-test.
# Usage: defend-attack-test [path]
A=${1:-$(dirname "$0")/defend-attack}
A=$(cd "$(dirname "$A")" && pwd)/$(basename "$A")
T=$(mktemp -d); trap 'command rm -r "$T"' EXIT
[ -x "$A" ] || { echo "not executable: $A"; exit 1; }
ok=0; bad=0
check() { if eval "$2"; then ok=$((ok+1)); else bad=$((bad+1)); echo "FAIL: $1"; fi; }

# A stub model: saves each prompt as <name>.<n>.prompt and prints reply file <name>.<n> (exit 1 if that file is missing).
cat > "$T/stub" <<'EOF'
#!/bin/bash
d=$1; n=$2; c=$(( $(cat "$d/$n.count" 2>/dev/null || echo 0) + 1 )); echo $c > "$d/$n.count"
cat > "$d/$n.$c.prompt"; [ -f "$d/$n.$c" ] || exit 1; cat "$d/$n.$c"
EOF
chmod +x "$T/stub"
printf 'diff --git a/src/util.ts b/src/util.ts\n+export const x = 1;\n' > "$T/plain.diff"
mkdir -p "$T/repo"; git -C "$T/repo" init -q

# run <case> <diff> [env...]: stub dir $T/<case>, replies pre-seeded by the caller. Both screeners stay down unless seeded.
run() { local c=$1 d=$2; shift 2
  (cd "$T/repo" && env DEFEND_JEV_CMD="$T/stub $T/$c jev" DEFEND_HAIKU_CMD="$T/stub $T/$c haiku" DEFEND_OPUS_CMD="$T/stub $T/$c opus" "$@" \
    "$A" --diff "$d") > "$T/$c/out" 2>"$T/$c/err"; echo $? > "$T/$c/rc"; }
seed() { mkdir -p "$T/$1"; printf '%s\n' "$3" > "$T/$1/$2"; }
calls() { cat "$T/$1/$2.count" 2>/dev/null || echo 0; }
rc() { cat "$T/$1/rc"; }

# 1. prompt shape: diff fenced as untrusted, reviewer told it has no tools, lenses present.
seed c1 opus.1 'VERDICT: CLEAR'
run c1 "$T/plain.diff"
check "c1 diff in Opus prompt, fenced as untrusted" 'grep -q "export const x = 1" "$T/c1/opus.1.prompt" && grep -qi untrusted "$T/c1/opus.1.prompt"'
check "c1 prompt says the reviewer has no tools" 'grep -q "You have no tools" "$T/c1/opus.1.prompt"'
check "c1 built-in criteria numbered" 'grep -q "^C1: " "$T/c1/opus.1.prompt" && grep -qi "trust boundar" "$T/c1/opus.1.prompt"'

# 2. Opus BLOCK with a Blocking line: exit 1, line listed.
seed c2 opus.1 $'Blocking: qty scaled 10x without a cap\nVERDICT: BLOCK'
run c2 "$T/plain.diff"
check "c2 BLOCK by opus, exit 1" '[ "$(rc c2)" = 1 ] && tail -n1 "$T/c2/out" | grep -qx "VERDICT: BLOCK by=opus"'
check "c2 blocking listed" 'grep -q "^Blocking: qty scaled" "$T/c2/out"'

# 3. unreadable Opus replies are exit 2 with no verdict: CLEAR+Blocking, BLOCK without Blocking, no verdict.
seed c3 opus.1 $'Blocking: x\nVERDICT: CLEAR'
run c3 "$T/plain.diff"
check "c3 CLEAR+Blocking -> exit 2, no verdict" '[ "$(rc c3)" = 2 ] && ! grep -q "^VERDICT:" "$T/c3/out"'
seed c3b opus.1 'VERDICT: BLOCK'
run c3b "$T/plain.diff"
check "c3b BLOCK without Blocking -> exit 2" '[ "$(rc c3b)" = 2 ] && ! grep -q "^VERDICT:" "$T/c3b/out"'
seed c3c opus.1 $'reply-marker-xyz\nno verdict here'
run c3c "$T/plain.diff"
check "c3c unreadable Opus reply shown" '[ "$(rc c3c)" = 2 ] && grep -q "reply-marker-xyz" "$T/c3c/err" && ! grep -q "^VERDICT:" "$T/c3c/out"'

# 4. an empty diff is unavailable (exit 2), never a CLEAR; no model call.
: > "$T/empty.diff"; mkdir -p "$T/c4"
run c4 "$T/empty.diff"
check "c4 empty diff exit 2, no model call" '[ "$(rc c4)" = 2 ] && [ "$(calls c4 jev)" = 0 ] && [ "$(calls c4 opus)" = 0 ]'

# 5. PR mode: -R reaches gh as two args, the diff is pinned to the head sha, which is printed.
mkdir -p "$T/bin"
cat > "$T/bin/gh" <<'EOF'
#!/bin/bash
# The diff is fetched by sha (compare base...head), never `gh pr diff`: right after a push that
# endpoint can still serve the previous head's diff (repos-x2i2).
if [ "$1 $2 $3 $4 $5" = "pr view 7 -R o/r" ]; then
  echo '{"headRefOid":"1111111aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","baseRefOid":"0000000bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb","url":"https://github.com/o/r/pull/7"}'; exit 0
fi
[ "$1 $2" = "api repos/o/r/compare/0000000bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb...1111111aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" ] || { echo "bad gh args: $*" >&2; exit 1; }
printf 'diff --git a/src/util.ts b/src/util.ts\n+export const x = 1;\n'
EOF
chmod +x "$T/bin/gh"
seed c5 opus.1 'VERDICT: CLEAR'
(cd "$T/repo" && env PATH="$T/bin:$PATH" DEFEND_JEV_CMD="$T/stub $T/c5 jev" DEFEND_HAIKU_CMD="$T/stub $T/c5 haiku" DEFEND_OPUS_CMD="$T/stub $T/c5 opus" \
  "$A" 7 -R o/r) > "$T/c5/out" 2>"$T/c5/err"; echo $? > "$T/c5/rc"
check "c5 -R reaches gh as two args" '[ "$(rc c5)" = 0 ] && grep -q "export const x = 1" "$T/c5/opus.1.prompt"'
check "c5 diff pinned to the head sha, which is printed" 'grep -qx "Reviewed: 1111111aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" "$T/c5/out" && tail -n1 "$T/c5/out" | grep -qx "VERDICT: CLEAR by=opus"'

# 6. a PR argument that is not a number (flag-like) is refused before gh or any model runs.
mkdir -p "$T/c6"
for a in --web -w; do
  (cd "$T/repo" && env PATH="$T/bin:$PATH" DEFEND_JEV_CMD="$T/stub $T/c6 jev" DEFEND_OPUS_CMD="$T/stub $T/c6 opus" "$A" "$a") > "$T/c6/out" 2>"$T/c6/err"; r=$?
  check "c6 $a refused" '[ "$r" = 2 ] && ! grep -q "bad gh args" "$T/c6/err" && [ "$(calls c6 jev)" = 0 ]'
done

# 7. Opus command fails after printing an error: exit 2, and the error text reaches stderr.
mkdir -p "$T/c7"; printf '#!/bin/bash\ncat > /dev/null; echo "API Error: flagged"; exit 1\n' > "$T/c7/opus"; chmod +x "$T/c7/opus"
(cd "$T/repo" && env DEFEND_JEV_CMD="$T/stub $T/c7 jev" DEFEND_HAIKU_CMD="$T/stub $T/c7 haiku" DEFEND_OPUS_CMD="$T/c7/opus" \
  "$A" --diff "$T/plain.diff") > "$T/c7/out" 2>"$T/c7/err"; echo $? > "$T/c7/rc"
check "c7 Opus failure: exit 2, no verdict" '[ "$(rc c7)" = 2 ] && ! grep -q "^VERDICT" "$T/c7/out"'
check "c7 Opus failure shows the cause" 'grep -q "Opus command failed: API Error: flagged" "$T/c7/err"'

# 8. Default Opus call loads no tools: --tools "" drops built-ins, --strict-mcp-config and
#    ENABLE_CLAUDEAI_MCP_SERVERS=false drop MCP and claude.ai connector tools (a connector's
#    "make a doc first" instruction cost a second turn and error_max_turns, repos-u68g).
mkdir -p "$T/c8/bin"
cat > "$T/c8/bin/claude" <<'EOF'
#!/bin/bash
printf '%s\n' "$@" > "$C8/argv"; echo "${ENABLE_CLAUDEAI_MCP_SERVERS-unset}" > "$C8/env"; cat > /dev/null
echo 'VERDICT: CLEAR'
EOF
chmod +x "$T/c8/bin/claude"
(cd "$T/repo" && env -u DEFEND_OPUS_CMD -u ENABLE_CLAUDEAI_MCP_SERVERS PATH="$T/c8/bin:$PATH" C8="$T/c8" \
  DEFEND_JEV_CMD="$T/stub $T/c8 jev" "$A" --diff "$T/plain.diff") > "$T/c8/out" 2>"$T/c8/err"; echo $? > "$T/c8/rc"
check "c8 default Opus call: CLEAR by opus" '[ "$(rc c8)" = 0 ] && tail -n1 "$T/c8/out" | grep -qx "VERDICT: CLEAR by=opus"'
check "c8 default Opus call removes built-in tools" 'grep -qx -- "--tools" "$T/c8/argv" && [ "$(grep -A1 -x -- "--tools" "$T/c8/argv" | tail -n1)" = "" ]'
check "c8 default Opus call loads no MCP config" 'grep -qx -- "--strict-mcp-config" "$T/c8/argv"'
check "c8 default Opus call disables claude.ai connectors" '[ "$(cat "$T/c8/env")" = false ]'
check "c8 default Opus call skips agent rules and hooks" 'grep -qx -- "--safe-mode" "$T/c8/argv"'
check "c8 default Opus is opus at high effort" 'grep -qx -- "opus" "$T/c8/argv" && grep -qx -- "high" "$T/c8/argv"'

# 9. the DEFAULT screener (no DEFEND_JEV_CMD) posts to laneproxy systemone on the fast lane, one noul question per
#    criterion, body on stdin (no ARG_MAX on big diffs); a probability >= 0.5 is a FAIL. A fake curl stands in for laneproxy.
mkdir -p "$T/c9/bin"
cat > "$T/c9/bin/curl" <<'EOF'
#!/bin/bash
echo "$*" > "$C9/args"; cat > "$C9/body"
echo '{"answers":{"C1":{"noul":0.9},"C2":{"noul":0.1},"C3":{"noul":0.1},"C4":{"noul":0.1},"C5":{"noul":0.1},"C6":{"noul":0.1}}}'
EOF
chmod +x "$T/c9/bin/curl"
seed c9 opus.1 'VERDICT: CLEAR'
(cd "$T/repo" && env -u DEFEND_JEV_CMD PATH="$T/c9/bin:$PATH" C9="$T/c9" DEFEND_HAIKU_CMD="$T/stub $T/c9 haiku" DEFEND_OPUS_CMD="$T/stub $T/c9 opus" \
  "$A" --diff "$T/plain.diff") > "$T/c9/out" 2>"$T/c9/err"; echo $? > "$T/c9/rc"
check "c9 default JEV: fast lane, systemone, 8099" 'grep -q "x-lane: fast" "$T/c9/args" && grep -q "/v1/systemone" "$T/c9/args" && grep -q 8099 "$T/c9/args"'
check "c9 default JEV: body on stdin with noul question per criterion" 'jq -e "(.messages[0].content | test(\"export const x = 1\")) and (.questions | length == 6) and (.questions.C1.type == \"noul\") and (.questions.C1.instructions | startswith(\"This change fails the criterion: \"))" "$T/c9/body" >/dev/null'
check "c9 default JEV: yes-probability 0.9 flags C1 only" 'grep -qx "Screener: jev fails=1" "$T/c9/out" && grep -q "Screener flagged" "$T/c9/opus.1.prompt" && [ "$(calls c9 haiku)" = 0 ]'

echo "defend-attack-test: $ok ok, $bad failed"
[ "$bad" = 0 ] && echo "defend-attack-test: PASS"
[ "$bad" = 0 ]
