#!/bin/bash
# defend-ask — launch ONE adversarial reviewer run under the reviewer-prompt contract.
#
# Why this exists (repos-18bvp, measured 2026-11-20): three review runs returned
# no verdict. Each failed on a different piece of prompt hygiene, and each piece
# was invisible to the caller. This wrapper refuses to launch a prompt that
# cannot produce a verdict, and computes the wall clock from the budget instead
# of reusing a flat number that let a slow model time out mid-read.
#
# The contract it enforces (all four, see ../reviewer-prompt.md):
#   1. a forced verdict line          -> "VERDICT: CLEAR" | "VERDICT: ATTACKS"
#   2. a tool budget + emit-by         -> "Cap: N tool calls"
#   3. artifact status is stated      -> design-vs-code ambiguity, not inferred
#   4. real artifacts named on disk   -> at least one absolute path that EXISTS
# If 1-3 are missing the canonical block is appended (never silently skipped);
# if 4 fails the run is refused, because a reviewer pointed at nothing reports
# nothing (or worse, reports on a stale revision).
#
# usage: defend-ask <prompt-file> [--calls N] [--model M] [--thinking LEVEL]
#                                 [--tools LIST] [--dry-run]
# Exit: 0 launched with a verdict, 2 bad prompt/artifact/model, 3 ran with NO
# verdict (gated nothing — not a pass), 124 wall clock exhausted.
set -uo pipefail

MARK='## REVIEWER CONTRACT (defend-ask)'
# default reviewer model: ollama-cloud/deepseek-v4-pro:0813
#   operator 2026-11-20 23:0xZ, verbatim: "ollama-cloud/glm-5.3 is banned" — no glm-5.x in any
#   contract default. Chosen over deepseek-v4.1-flash because the reviewer path is the one place a
#   wrong answer is acted on by a human, and pro is the model that actually returned a verdict in the
#   20-call budget (see the timeout note below). Same family as the infrastructure seats' default
#   (deepseek-v4.1-flash), so prompt/format behaviour is identical across seat and gate.
#   Override per run with --model; the ban applies to overrides too.
prompt="" calls=40 model="ollama-cloud/deepseek-v4-pro:0813" thinking="" tools="" dry=0

while [ $# -gt 0 ]; do
  case "$1" in
    --calls) calls="${2:-}"; shift 2 ;;
    --model) model="${2:-}"; shift 2 ;;
    --thinking) thinking="${2:-}"; shift 2 ;;
    --tools) tools="${2:-}"; shift 2 ;;
    --dry-run) dry=1; shift ;;
    -h|--help) sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "defend-ask: unknown flag $1" >&2; exit 2 ;;
    *) prompt="$1"; shift ;;
  esac
done

[ -n "$prompt" ] || { echo "defend-ask: need a prompt file" >&2; exit 2; }
[ -s "$prompt" ] || { echo "defend-ask: prompt file missing or empty: $prompt" >&2; exit 2; }
case "$calls" in ''|*[!0-9]*) echo "defend-ask: --calls must be a number" >&2; exit 2 ;; esac
[ "$calls" -ge 5 ] || { echo "defend-ask: --calls $calls is too small to reach a verdict" >&2; exit 2; }

# --- contract check 1-3 -----------------------------------------------------
missing=()
grep -qE '^VERDICT: (CLEAR|ATTACKS)|VERDICT: CLEAR' "$prompt" || missing+=("forced verdict line")
grep -qiE 'cap: *[0-9]+ tool call|tool call limit|tool budget' "$prompt" || missing+=("tool budget")
grep -qiE 'artifact status|this is a design|design document, the (code|feature)' "$prompt" \
  || missing+=("artifact status (design vs already-merged code)")

if [ ${#missing[@]} -gt 0 ] && ! grep -qF "$MARK" "$prompt"; then
  echo "defend-ask: prompt is missing ${#missing[@]} contract item(s): ${missing[*]}" >&2
  eff="$prompt.effective"
  echo "defend-ask: canonical block appended to a COPY at $eff (the input prompt is never modified)" >&2
  cp "$prompt" "$eff"
  cat >> "$eff" <<EOF

$MARK
ARTIFACT STATUS: the named artifacts are the ground truth for this review. If a
mechanism described in the design is not present in the code, that is the
PREMISE (the design is the proposal) unless the design claims it is already
merged — do not spend calls proving an unimplemented feature is unimplemented.

BUDGET: Cap: $calls tool calls. Emit your verdict by call $calls no matter what
you have read. Breadth-first: never open a file twice, never read a file whole
when grep + a line range answers the question.

UNRESOLVED is a real answer: if something cannot be settled from the files, say
UNRESOLVED and why. Silence or a timeout is a failed run; a stated gap is a
usable finding.

VERDICT — your final message MUST start with exactly one line:
VERDICT: CLEAR
or
VERDICT: ATTACKS
Followed by numbered findings: severity (FATAL/MAJOR/MINOR), the exact input or
command, the observed output, and one sentence of consequence. If CLEAR, name
the strongest three attacks you tried that failed.
EOF
fi

# --- contract check 4: at least one named artifact must exist ---------------
found=0
while IFS= read -r p; do
  [ -e "$p" ] && { found=1; break; }
done < <(grep -oE '/[A-Za-z0-9._/-]+' "$prompt" | sort -u)
if [ "$found" -eq 0 ]; then
  echo "defend-ask: REFUSED — no absolute path in the prompt exists on this host." >&2
  echo "defend-ask: a reviewer with no readable artifact reviews a memory, not the work." >&2
  exit 2
fi

# --- timeout from budget, not a flat 1500s ---------------------------------
# 90s/tool call + 600s of thinking/writing. 18bvp's silent kill was a flat 1500s
# for 18 calls on ollama-cloud/fast (83s/call), so anything under 90s/call repeats
# it. Measured 2026-11-20: 40 calls on a large cloud reviewer = ~1440s. calls=40 -> 4200s,
# calls=20 -> 2400s (the value that actually returned a verdict on deepseek-v4-pro today).
tmo=$(( 600 + 90 * calls ))
[ "$tmo" -ge 1200 ] || tmo=1200

argv=(pi -p --print --model "$model")
[ -n "$thinking" ] && argv=(pi -p --print --model "$model" --thinking "$thinking")
[ -n "$tools" ] && argv+=(-t "$tools")

src="${eff:-$prompt}"

# --- model preflight -------------------------------------------------------
# A 404 model id is a run that burns the wall clock and returns no verdict
# (measured 20:30Z: `--model ollama-cloud/fast` -> 404, "fast" is a v100 lane).
prov="${model%%/*}"; mid="${model#*/}"
if [ "$prov" = "$model" ]; then echo "defend-ask: --model must be provider/id (got '$model')" >&2; exit 2; fi
if ! pi --list-models 2>/dev/null | awk -v p="$prov" -v m="$mid" '$1==p && $2==m{f=1} END{exit !f}'; then
  echo "defend-ask: REFUSED — '$model' is not in the model catalog. Available on that provider:" >&2
  pi --list-models 2>/dev/null | awk -v p="$prov" '$1==p{printf "  %s/%s\n",$1,$2}' >&2
  exit 2
fi

echo "defend-ask: prompt=$src calls=$calls model=$model thinking=${thinking:-default} timeout=${tmo}s"
[ "$dry" -eq 1 ] && { echo "defend-ask: dry-run, not launching"; exit 0; }

outfile="$src.out"
timeout "$tmo" "${argv[@]}" "$(cat "$src")" 2>&1 | tee "$outfile"
rc=${PIPESTATUS[0]}
if [ "$rc" -eq 124 ]; then
  echo "defend-ask: TIMED OUT after ${tmo}s with no verdict — treat as UNRESOLVED; lower --calls or move to a faster model rather than re-running blind." >&2
  exit 124
fi
# A run with no verdict line has gated nothing, whatever its exit code.
if ! grep -qE '^VERDICT: (CLEAR|ATTACKS)' "$outfile"; then
  echo "defend-ask: NO VERDICT in $outfile (pi rc=$rc) — this run gated NOTHING. Not a pass; re-run narrowed." >&2
  exit 3
fi
echo "defend-ask: verdict line present; transcript: $outfile" >&2
exit "$rc"
