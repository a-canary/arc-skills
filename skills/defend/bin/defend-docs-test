#!/bin/bash
# Docs acceptance: docs name defend-attack as the DefendMerge reviewer.
m=skills/defend/merge.md; h=skills/hard-merge/SKILL.md; f=skills/defend/SKILL.md
fail=0
t() { if eval "$2"; then echo "ok   $1"; else echo "FAIL $1"; fail=1; fi; }
t "merge.md names defend-attack" "grep -q 'defend-attack' $m"
t "merge.md documents DEFEND_OPUS_SCOPE default all" "grep -q 'DEFEND_OPUS_SCOPE' $m && grep -qi 'default is .all.' $m"
t "hard-merge: Opus attacks every diff" "grep -qi 'Opus attacks every' $h"
t "merge.md: exit 2 means no receipt" "grep -qi 'exit 2' $m"
t "merge.md: deploy exemption for already-cleared SHAs" "grep -qi 'exemption' $m && grep -qi 'already' $m"
t "merge.md keeps receipt + champion text" "grep -q 'defend-receipt CLEAR|BLOCK' $m && grep -q 'champion-check' $m"
t "hard-merge names defend-attack" "grep -q 'defend-attack' $h"
t "hard-merge drops 'no Opus'" "! grep -q 'no Opus' $h"
t "hard-merge keeps the second spawned reviewer" "grep -qi 'second' $h && grep -qi 'spawned' $h"
t "hard-merge keeps the receipt step" "grep -q 'defend-receipt CLEAR' $h"
t "defend/SKILL.md drops workhorse wording" "! grep -qi workhorse $f"
t "no skill calls DefendMerge workhorse or no-Opus" "! grep -rn -i 'DefendMerge' skills --include=*.md | grep -qi 'workhorse\\|no Opus'"
t "no skill calls /hard-merge no-Opus" "! grep -rqi 'hard-merge, no Opus' skills --include=*.md"
exit $fail
