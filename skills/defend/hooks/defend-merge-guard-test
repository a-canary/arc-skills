#!/usr/bin/env bash
# defend-merge-guard-test — guard + receipt against a stub gh, no network.
# Stub gh: `pr view` prints $STUB_PR (exit 1 if unset); `api` logs args and prints $STUB_STATUS.
set -uo pipefail
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
fail=0

mkdir "$tmp/bin"
cat > "$tmp/bin/gh" <<'EOF'
#!/usr/bin/env bash
echo "$*" >> "$STUB_LOG"
case "$1 $2" in
  "pr view") [ -n "${STUB_PR:-}" ] || exit 1; echo "$STUB_PR" ;;
  "api "*) [ "$2" = repos/o/r/commits/abc1234/status ] && echo "$STUB_STATUS" || echo '{"statuses":[]}' ;;
  *) exit 1 ;;
esac
EOF
chmod +x "$tmp/bin/gh"
export PATH="$tmp/bin:$PATH" STUB_LOG="$tmp/log"
pr='{"headRefOid":"abc1234","url":"https://github.com/o/r/pull/5"}'
st() { printf '{"statuses":[{"context":"defend/merge","state":"%s"}]}' "$1"; }

# $1 name, $2 command, $3 expected exit, env STUB_PR/STUB_STATUS set by caller
guard() {
  local name=$1 cmd=$2 want=$3
  : > "$STUB_LOG"
  jq -n --arg c "$cmd" '{tool_name:"Bash",tool_input:{command:$c},cwd:"/tmp"}' \
    | "$here/defend-merge-guard.sh" >/dev/null 2>&1
  local rc=$?
  if [ $rc -eq "$want" ]; then echo "PASS  $name"; else echo "FAIL  $name (rc=$rc want=$want)"; fail=1; fi
}
# $1 grep pattern the stub log must contain, $2 name
expect_log() { if grep -q "$1" "$STUB_LOG"; then echo "PASS  $2"; else echo "FAIL  $2"; cat "$STUB_LOG"; fail=1; fi; }

STUB_PR=$pr STUB_STATUS='{"statuses":[]}' guard "no receipt blocks" 'gh pr merge 5 -R o/r --squash' 2
STUB_PR=$pr STUB_STATUS=$(st failure)      guard "BLOCK receipt blocks" 'gh pr merge 5 -R o/r --squash' 2
STUB_PR=$pr STUB_STATUS=$(st pending)      guard "pending receipt blocks" 'gh pr merge 5 -R o/r' 2
STUB_PR=$pr STUB_STATUS=$(st success)      guard "CLEAR receipt allows" 'gh pr merge 5 -R o/r --squash' 0
STUB_PR=$pr STUB_STATUS=$(st success)      guard "chained after cd allows" 'cd /tmp && gh pr merge 5 --squash' 0
STUB_PR=$pr STUB_STATUS='{"statuses":[]}'  guard "second merge in chain checked" 'echo hi; gh pr merge 5 -R o/r' 2
STUB_PR=$pr STUB_STATUS='{"statuses":[]}'  guard "merge on later line checked" $'echo hi\ngh pr merge 5 -R o/r' 2
STUB_PR=                                   guard "unresolvable PR fails closed" 'gh pr merge 5 --squash' 2
STUB_PR=$pr STUB_STATUS='{"statuses":[]}'  guard "non-merge command ignored" 'gh pr view 5' 0
STUB_PR=$pr STUB_STATUS='{"statuses":[]}'  guard "mention in commit msg ignored" 'git commit -m "then gh pr merge 5"' 0
STUB_PR=$pr STUB_STATUS='{"statuses":[]}'  guard "separator in commit msg ignored" 'git commit -m "wip; gh pr merge 5 later"' 0
# gh after keywords/wrappers is still found
STUB_PR=$pr STUB_STATUS=$(st success)      guard "for-loop variable selector fails closed" 'for p in 5; do gh pr merge $p -R o/r; done' 2
STUB_PR=$pr STUB_STATUS='{"statuses":[]}'  guard "merge after then checked" 'if gh pr checks 5 --watch; then gh pr merge 5 -R o/r; fi' 2
STUB_PR=$pr STUB_STATUS='{"statuses":[]}'  guard "timeout wrapper checked" 'timeout 300 gh pr merge 5 -R o/r' 2
STUB_PR=$pr STUB_STATUS='{"statuses":[]}'  guard "env wrapper checked" 'env GH_TOKEN=x gh pr merge 5 -R o/r' 2
STUB_PR=$pr STUB_STATUS='{"statuses":[]}'  guard "brace group checked" '{ gh pr merge 5 -R o/r; }' 2
STUB_PR=$pr STUB_STATUS='{"statuses":[]}'  guard "line continuation checked" $'gh \\\n  pr merge 5 -R o/r' 2
STUB_PR=$pr STUB_STATUS='{"statuses":[]}'  guard "absolute gh path checked" '/usr/bin/gh pr merge 5 -R o/r' 2
STUB_PR=$pr STUB_STATUS=$(st success)      guard "xargs merge fails closed" 'echo 5 | xargs gh pr merge' 2
STUB_PR=$pr STUB_STATUS=$(st success)      guard "sh -c merge fails closed" 'sh -c "gh pr merge 5"' 2
STUB_PR=$pr STUB_STATUS=$(st success)      guard "failed quoted cd ok with -R" 'cd "/nonexistent" && gh pr merge 5 -R o/r' 0
STUB_PR=$pr STUB_STATUS=$(st success)      guard "cd \$HOME tracked" 'cd $HOME && gh pr merge 5 -R o/r' 0
STUB_PR=$pr STUB_STATUS=$(st success)      guard "quoted body with #N allows" 'gh pr merge --squash --body "see #12 for context" 5 -R o/r' 0
expect_log '^pr view 5 ' "body text not taken as selector"
STUB_PR=$pr STUB_STATUS='{"statuses":[]}'  guard "escaped quote can't desync pairing" 'git commit -m "x\""; gh pr merge 5 -R o/r; git log "y"' 2
STUB_PR=$pr STUB_STATUS='{"statuses":[]}'  guard "ansi-c quote can't desync pairing" $'git commit -m $\'it\\\'s\'; gh pr merge 5 -R o/r; git log \'y\'' 2
STUB_PR=$pr STUB_STATUS=$(st success)      guard "merge in \"\$(…)\" under git fails closed" 'git commit -m "$(gh pr merge 5 -R o/r)"' 2
STUB_PR=$pr STUB_STATUS=$(st success)      guard "export GH_REPO carries to merge" 'export GH_REPO=o/r; gh pr merge 5' 0
expect_log '^pr view 5 -R o/r' "export GH_REPO used for lookup"
STUB_PR=$pr STUB_STATUS='{"statuses":[]}'  guard "gh pr -R X merge checked" 'gh pr -R o/r merge 5' 2
STUB_PR=$pr STUB_STATUS=$(st success)      guard "gh pr --repo=X merge allows" 'gh pr --repo=o/r merge 5' 0
expect_log '^pr view 5 -R o/r' "pre-subcommand repo used for lookup"
STUB_PR=$pr STUB_STATUS=$(st success)      guard "-R beats inline GH_REPO" 'GH_REPO=x/y gh pr -R o/r merge 5' 0
expect_log '^pr view 5 -R o/r' "-R wins over GH_REPO prefix for lookup"

# non-Bash tool payload is ignored
: > "$STUB_LOG"
if echo '{"tool_name":"Read","tool_input":{"file_path":"x"}}' | "$here/defend-merge-guard.sh" >/dev/null 2>&1; then
  echo "PASS  non-Bash tool ignored"; else echo "FAIL  non-Bash tool ignored"; fail=1; fi

# receipt posts a SHA-bound status on the reviewed commit
: > "$STUB_LOG"
STUB_PR=$pr "$here/../bin/defend-receipt" CLEAR 5 abc1234 -R o/r "no blockers" >/dev/null 2>&1
expect_log 'api -X POST repos/o/r/statuses/abc1234 -f state=success -f context=defend/merge -f description=no blockers' "receipt CLEAR posts success"
: > "$STUB_LOG"
if STUB_PR=$pr "$here/../bin/defend-receipt" MAYBE 5 abc1234 "x" >/dev/null 2>&1; then
  echo "FAIL  receipt rejects bad verdict"; fail=1; else echo "PASS  receipt rejects bad verdict"; fi
if STUB_PR=$pr "$here/../bin/defend-receipt" CLEAR 5 a -R o/r "x" >/dev/null 2>&1; then
  echo "FAIL  receipt rejects 1-char sha"; fail=1; else echo "PASS  receipt rejects 1-char sha"; fi
: > "$STUB_LOG"
out=$(STUB_PR=$pr "$here/../bin/defend-receipt" CLEAR 5 abc1234 "no blockers" -R o/r 2>/dev/null)
expect_log '^pr view 5 -R o/r' "receipt -R after summary honored"
if [[ $out == *CLEAR* ]]; then echo "PASS  receipt output names verdict"; else echo "FAIL  receipt output names verdict: $out"; fail=1; fi
exit $fail
